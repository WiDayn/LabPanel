# LabPanel 配置文件
# 复制此文件为 .env 并修改相应配置

# 服务端口
PORT=8080

# JWT 密钥（生产环境请修改为强密钥）
JWT_SECRET=your-secret-key-change-in-production

# 管理员用户名
ADMIN_USERNAME=admin

# 管理员密码
ADMIN_PASSWORD=admin123

# FRP 配置文件路径。若安装时选择不配置 FRP，可以留空。
TOML_PATH=/etc/frp/frpc.toml

# frpc 可执行文件路径
FRPC_PATH=/usr/local/bin/frpc

# Systemd 服务名称
SERVICE_NAME=frpc

# 文档、上传和备份目录
DOCS_PATH=./docs
UPLOAD_PATH=./uploads
LXC_BACKUP_DIR=./backups

# 默认 LXC 镜像
LXC_IMAGE=ubuntu:22.04
