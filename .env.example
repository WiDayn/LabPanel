# LabPanel 配置文件
# 复制此文件为 .env 并修改相应配置

# 服务端口
PORT=8080

# 面板标题，会同时用于浏览器 title 和顶部标题
APP_TITLE="LabPanel 管理面板"

# JWT 密钥（生产环境请修改为强密钥）
JWT_SECRET=your-secret-key-change-in-production

# 管理员用户名
ADMIN_USERNAME=admin

# 管理员密码
ADMIN_PASSWORD=admin123

# LabPanel systemd 服务名称
APP_SERVICE=lab-panel

# FRP systemd 服务名称
FRP_SERVICE=frpc

# GitHub 镜像前缀。留空则直连，例如：https://gh-proxy.com/
GITHUB_PROXY=

# HTTP(S) 代理。留空则不设置，例如：http://127.0.0.1:7890
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=

# FRP 配置文件路径。若安装时选择不配置 FRP，可以留空。
TOML_PATH=/etc/frp/frpc.toml

# frpc 可执行文件路径
FRPC_PATH=/usr/local/bin/frpc

# 文档、上传和备份目录
DOCS_PATH=./docs
UPLOAD_PATH=./uploads
LXC_BACKUP_DIR=./backups
LXC_GROUPS_PATH=./lxc_groups.json

# 监控数据 SQLite 存储。METRICS_RETENTION_DAYS=0 表示不自动清理。
METRICS_DB_PATH=./data/metrics.db
METRICS_RETENTION_DAYS=30

# 默认 LXC 镜像
LXC_IMAGE=ubuntu:22.04
